{
  "extends": "@tsconfig/node22/tsconfig.json",
  // Two app files come along, for the same reason in both cases: a test that
  // reads IndexedDB should be held to what the app actually writes, rather
  // than to a copy of it. `workout.ts` is the shape of a stored session;
  // `db.constants.ts` is the prefix a logout clears out of the `meta` store,
  // which a test asserting that it is gone has to name. Neither can come in as
  // a project reference: tsconfig.app.json disables emit, which a referenced
  // project may not do.
  "include": ["e2e/**/*", "src/types/workout.ts", "src/services/db.constants.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The tests run in node, but the callbacks they hand to page.evaluate run
    // in the browser, so both sets of globals have to be in scope.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  }
}
